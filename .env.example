# --- Grist ---
# Clé API Grist : Profil > Account settings > Developer > API keys
GRIST_API_KEY=coller_votre_cle_api_grist_ici

# Base de l'API Grist.
# Grist Cloud (SaaS) :        https://docs.getgrist.com/api
# Site d'équipe Grist Cloud : https://VOTRE-SITE.getgrist.com/api
# Instance auto-hébergée :    https://votre-domaine.tld/api
GRIST_API_URL=https://docs.getgrist.com/api

# --- Sécurité du micro-service MCP lui-même ---
# Jeton que Perplexity devra présenter (Authorization: Bearer ...) pour
# appeler ce serveur MCP. Générez une valeur aléatoire forte (ex: openssl rand -hex 32).
MCP_SERVER_TOKEN=changez_moi_avec_un_secret_aleatoire

# Port d'écoute HTTP local
PORT=3939
